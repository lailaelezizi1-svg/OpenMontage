# Copia in .env (mai committare). Nessun valore reale in questo file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
MAILBOX_USER=
MAILBOX_APP_PASSWORD=
# Dove ricevi le notifiche
NOTIFY_TO=
# Opzionale: Google Places API (credito gratuito mensile). Senza, si usa OpenStreetMap.
GOOGLE_PLACES_API_KEY=
